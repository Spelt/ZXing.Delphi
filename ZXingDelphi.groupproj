<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{72263279-BD40-4924-B404-E92C43F54569}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="demo\ZXingScanner\ZXingScanner.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="demo\vclTestApp\vclTestApp.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="demo\webcam\Webcam.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="UnitTest\dUnitXTest.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="unitTest\DUnitXTestMobile.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="ZXingScanner">
        <MSBuild Projects="demo\ZXingScanner\ZXingScanner.dproj"/>
    </Target>
    <Target Name="ZXingScanner:Clean">
        <MSBuild Projects="demo\ZXingScanner\ZXingScanner.dproj" Targets="Clean"/>
    </Target>
    <Target Name="ZXingScanner:Make">
        <MSBuild Projects="demo\ZXingScanner\ZXingScanner.dproj" Targets="Make"/>
    </Target>
    <Target Name="vclTestApp">
        <MSBuild Projects="demo\vclTestApp\vclTestApp.dproj"/>
    </Target>
    <Target Name="vclTestApp:Clean">
        <MSBuild Projects="demo\vclTestApp\vclTestApp.dproj" Targets="Clean"/>
    </Target>
    <Target Name="vclTestApp:Make">
        <MSBuild Projects="demo\vclTestApp\vclTestApp.dproj" Targets="Make"/>
    </Target>
    <Target Name="Webcam">
        <MSBuild Projects="demo\webcam\Webcam.dproj"/>
    </Target>
    <Target Name="Webcam:Clean">
        <MSBuild Projects="demo\webcam\Webcam.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Webcam:Make">
        <MSBuild Projects="demo\webcam\Webcam.dproj" Targets="Make"/>
    </Target>
    <Target Name="dUnitXTest">
        <MSBuild Projects="UnitTest\dUnitXTest.dproj"/>
    </Target>
    <Target Name="dUnitXTest:Clean">
        <MSBuild Projects="UnitTest\dUnitXTest.dproj" Targets="Clean"/>
    </Target>
    <Target Name="dUnitXTest:Make">
        <MSBuild Projects="UnitTest\dUnitXTest.dproj" Targets="Make"/>
    </Target>
    <Target Name="DUnitXTestMobile">
        <MSBuild Projects="unitTest\DUnitXTestMobile.dproj"/>
    </Target>
    <Target Name="DUnitXTestMobile:Clean">
        <MSBuild Projects="unitTest\DUnitXTestMobile.dproj" Targets="Clean"/>
    </Target>
    <Target Name="DUnitXTestMobile:Make">
        <MSBuild Projects="unitTest\DUnitXTestMobile.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="ZXingScanner;vclTestApp;Webcam;dUnitXTest;DUnitXTestMobile"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="ZXingScanner:Clean;vclTestApp:Clean;Webcam:Clean;dUnitXTest:Clean;DUnitXTestMobile:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="ZXingScanner:Make;vclTestApp:Make;Webcam:Make;dUnitXTest:Make;DUnitXTestMobile:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
