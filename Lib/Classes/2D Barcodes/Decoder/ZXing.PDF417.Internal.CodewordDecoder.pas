unit ZXing.PDF417.Internal.CodewordDecoder;

interface

const
  NUMBER_OF_CODEWORDS = 929;
  // the maximum number of codewords (data + error correction)
  MAX_CODEWORDS_IN_BARCODE = NUMBER_OF_CODEWORDS - 1;
  MODULES_IN_CODEWORD = 17;
  BARS_IN_MODULE = 8;

type
  TModuleBitCount = array [0 .. BARS_IN_MODULE - 1] of Integer;
  /// <summary>The 6 edge to similar edge widths of a codeword, in
  /// modules.</summary>
  TCodewordE2E = array [0 .. 5] of Integer;

/// <summary>The codeword (0 to 928) of a symbol (17 bits, bars as 1);
/// -1 when it is not a valid symbol.</summary>
function GetCodeword(symbol: Integer): Integer;
/// <summary>The symbol for the bar and space widths of a codeword (in
/// pixels): sampled, or else the closest one.</summary>
function GetDecodedValue(const moduleBitCount: TModuleBitCount): Integer;
/// <summary>The codeword for the normalized edge to similar edge widths of
/// a codeword; -1 when there is none.</summary>
function GetCodewordFromE2E(const ne2ep: TCodewordE2E): Integer;
/// <summary>The cluster (0, 3 or 6) of normalized edge to similar edge
/// widths.</summary>
function CodewordClusterE2E(const ne2ep: TCodewordE2E): Integer;

implementation

