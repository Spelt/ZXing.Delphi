type
  TCodewordPattern = record
    Codeword: Integer;
    Bits: Cardinal; // the packed normalized e2e pattern (3 bits each)
  end;

var
  // the bar widths (in modules) of every symbol and the sum of their squares
  BarSizes: array [0 .. SYMBOL_COUNT - 1, 0 .. BARS_IN_MODULE - 1] of ShortInt;
  SumOfSquares: array [0 .. SYMBOL_COUNT - 1] of Integer;
  // the codewords by packed e2e pattern, sorted by Bits
  CodewordPatterns: TArray<TCodewordPattern>;

function GetSymbol(idx: Integer): Integer; inline;
begin
  Result := SYMBOL_TABLE[idx] or $10000;
end;

function GetCodeword(symbol: Integer): Integer;
begin
  Result := -1;
  if ((symbol and Integer($FFFF0000)) <> $10000) then
    exit;
  symbol := symbol and $FFFF;
  // binary search
  var lo := 0;
  var hi := SYMBOL_COUNT - 1;
  while (lo <= hi) do
  begin
    var mid := (lo + hi) div 2;
    if (SYMBOL_TABLE[mid] < symbol) then
      lo := mid + 1
    else if (SYMBOL_TABLE[mid] > symbol) then
      hi := mid - 1
    else
      exit((CODEWORD_TABLE[mid] - 1) mod NUMBER_OF_CODEWORDS);
  end;
end;

function SampleBitCounts(const moduleBitCount: TModuleBitCount)
  : TModuleBitCount;
begin
  var bitCountSum: Single := 0;
  for var c in moduleBitCount do
    bitCountSum := bitCountSum + c;
  for var i := 0 to BARS_IN_MODULE - 1 do
    Result[i] := 0;
  var bitCountIndex := 0;
  var sumPreviousBits := 0;
  for var i := 0 to MODULES_IN_CODEWORD - 1 do
  begin
    var sampleIndex: Single := bitCountSum / (2 * MODULES_IN_CODEWORD) +
      (i * bitCountSum) / MODULES_IN_CODEWORD;
    if (sumPreviousBits + moduleBitCount[bitCountIndex] <= sampleIndex) then
    begin
      Inc(sumPreviousBits, moduleBitCount[bitCountIndex]);
      Inc(bitCountIndex);
      if (bitCountIndex = BARS_IN_MODULE) then
        break;
    end;
    Inc(Result[bitCountIndex]);
  end;
end;

function GetBitValue(const moduleBitCount: TModuleBitCount): Integer;
begin
  Result := 0;
  for var i := 0 to BARS_IN_MODULE - 1 do
    for var bit := 1 to moduleBitCount[i] do
      Result := (Result shl 1) or Ord(not Odd(i));
end;

function GetDecodedCodewordValue(const moduleBitCount: TModuleBitCount)
  : Integer;
begin
  Result := GetBitValue(moduleBitCount);
  if (GetCodeword(Result) = -1) then
    Result := -1;
end;

procedure InitBarSizes;
begin
  for var i := 0 to SYMBOL_COUNT - 1 do
  begin
    var currentSymbol := GetSymbol(i);
    var currentBit := currentSymbol and 1;
    SumOfSquares[i] := 0;
    for var j := 0 to BARS_IN_MODULE - 1 do
    begin
      var size := 0;
      while ((currentSymbol and 1) = currentBit) do
      begin
        Inc(size);
        currentSymbol := currentSymbol shr 1;
      end;
      currentBit := currentSymbol and 1;
      BarSizes[i, BARS_IN_MODULE - j - 1] := size;
      Inc(SumOfSquares[i], size * size);
    end;
  end;
end;

function GetClosestDecodedValue(const moduleBitCount: TModuleBitCount)
  : Integer;
begin
  // the symbol whose bar width ratios are closest to the measured ones:
  //   argmin_j sum_k (barSize[j][k] / 17 - moduleBitCount[k] / sum)^2
  // scaled by (17 * sum)^2 and without the term that is the same for every
  // symbol:
  //   argmin_j (sum * sumOfSquares[j] - 34 * dot(barSize[j], moduleBitCount))
  var sum := 0;
  for var c in moduleBitCount do
    Inc(sum, c);
  var bestScore := MaxInt;
  Result := -1;
  for var j := 0 to SYMBOL_COUNT - 1 do
  begin
    var dot := 0;
    for var k := 0 to BARS_IN_MODULE - 1 do
      Inc(dot, BarSizes[j, k] * moduleBitCount[k]);
    var score := sum * SumOfSquares[j] - 34 * dot;
    if (score < bestScore) then
    begin
      bestScore := score;
      Result := GetSymbol(j);
    end;
  end;
end;

function GetDecodedValue(const moduleBitCount: TModuleBitCount): Integer;
begin
  Result := GetDecodedCodewordValue(SampleBitCounts(moduleBitCount));
  if (Result = -1) then
    Result := GetClosestDecodedValue(moduleBitCount);
end;

{ e2e patterns }

/// <summary>The packed pattern (3 bits per value minus min); $FFFFFFFF when
/// a value does not fit.</summary>
function PackedPattern(const np: TCodewordE2E; min: Integer): Cardinal;
begin
  Result := 0;
  for var v in np do
  begin
    if (v < min) or (v - min >= 8) then
      exit($FFFFFFFF);
    Result := (Result shl 3) or Cardinal(v - min);
  end;
end;

function CodewordClusterE2E(const ne2ep: TCodewordE2E): Integer;
begin
  Result := (ne2ep[0] - ne2ep[1] + ne2ep[4] - ne2ep[5] + 9) mod 9;
end;

function ClusterOfBits(bits: Cardinal): Integer;

  function pattern(i: Integer): Integer;
  begin
    Result := (bits shr ((6 - i - 1) * 3)) and 7;
  end;

begin
  Result := (pattern(0) - pattern(1) + pattern(4) - pattern(5) + 9) mod 9;
end;

procedure InitCodewordPatterns;
begin
  SetLength(CodewordPatterns, SYMBOL_COUNT);
  for var i := 0 to SYMBOL_COUNT - 1 do
  begin
    // the bar and space widths of the symbol, from its last bits
    var value := Cardinal(GetSymbol(i));
    var widths: TModuleBitCount;
    for var k := BARS_IN_MODULE - 1 downto 0 do
    begin
      var bit := value and 1;
      var n := 0;
      while (n < 32) and ((value and 1) = bit) do
      begin
        Inc(n);
        value := value shr 1;
      end;
      widths[k] := n;
    end;
    // the normalized edge to similar edge widths (17 modules)
    var sum := 0;
    for var w in widths do
      Inc(sum, w);
    var moduleSize: Double := sum / MODULES_IN_CODEWORD;
    var np: TCodewordE2E;
    for var k := 0 to 5 do
      np[k] := Trunc((widths[k] + widths[k + 1]) / moduleSize + 0.5);
    CodewordPatterns[i].Codeword := (CODEWORD_TABLE[i] - 1) mod
      NUMBER_OF_CODEWORDS;
    CodewordPatterns[i].Bits := PackedPattern(np, 2);
  end;
  TArray.Sort<TCodewordPattern>(CodewordPatterns,
    TComparer<TCodewordPattern>.Construct(
    function(const a, b: TCodewordPattern): Integer
    begin
      if (a.Bits < b.Bits) then
        Result := -1
      else if (a.Bits > b.Bits) then
        Result := 1
      else
        Result := 0;
    end));
end;

function GetCodewordFromE2E(const ne2ep: TCodewordE2E): Integer;
begin
  Result := -1;
  var bits := PackedPattern(ne2ep, 2);
  if (bits = $FFFFFFFF) then
    exit;
  var cluster := CodewordClusterE2E(ne2ep);
  // the first pattern with Bits >= bits
  var lo := 0;
  var hi := Length(CodewordPatterns);
  while (lo < hi) do
  begin
    var mid := (lo + hi) div 2;
    if (CodewordPatterns[mid].Bits < bits) then
      lo := mid + 1
    else
      hi := mid;
  end;
  if (lo < Length(CodewordPatterns)) and (CodewordPatterns[lo].Bits = bits) and
    (ClusterOfBits(bits) = cluster) then
    Result := CodewordPatterns[lo].Codeword;
end;

initialization

InitBarSizes;
InitCodewordPatterns;

end.
